# /etc/ezarr/secrets.conf — TODO lo que es credencial, en un solo fichero.
#
# Este fichero NUNCA se versiona y debe estar en 600. No lo edites a mano si
# puedes evitarlo: `ezarrctl secrets set CLAVE` lo hace por ti, lo escribe en
# 600 y no deja el valor en el historial del shell.
#
#   ezarrctl secrets init          # crea este fichero desde la plantilla
#   ezarrctl secrets list          # que falta y que esta puesto (nunca el valor)
#   ezarrctl secrets set CLAVE     # te lo pide sin que se vea en pantalla
#   ezarrctl secrets doctor        # revisa permisos, obligatorias y valores de ejemplo
#
# Las marcadas como [OBLIGATORIA] son las que, sin poner, hacen que el stack
# parezca que funciona y no te avise de nada: por eso son las que no te vas a
# enterarte hasta que pasa algo gordo.

# ---------------------------------------------------------------------------
# [OBLIGATORIA] Password del RTSP de la camara.
# Es la del aparato, no la del usuario del sistema. Esta en la pegatina o en la
# app del fabricante. Si tu camara no pide usuario (muchas no lo piden), pon
# cualquier cosa: el valor se usa solo si hay credenciales en la URL.
EZARR_CAMERA_RTSP_PASS=

# ---------------------------------------------------------------------------
# [OBLIGATORIA] Topic de ntfy donde te van a llegar los avisos.
# Elige uno que no exista en ningun sitio publico mas: es una palabra secreta
# disfrazada de direccion. Crealo en https://ntfy.sh/ (o en tu servidor) con un
# nombre random, no con "ezarr". Sin topic no hay push: el watchdog curara bien
# pero no te contara nada.
EZARR_NTFY_TOPIC=

# ---------------------------------------------------------------------------
# [OPCIONAL] URL de Healthchecks.io (dead-man switch).
# El watchdog da "ping" a esta URL cada ronda. Si deja de dar pings mas alla del
# margen que pongas en Healthchecks.io, Healthchecks.io te avisa a TI. Es la
# unica forma de enterarte de que el watchdog ha muerto: si esta muerto, no puede
# avisarte. Copia la URL tal cual, SIN /fail (el watchdog lo añade el).
# Crear una: https://healthchecks.io -> New Check -> ping, margen 5 min.
EZARR_HC_PING_URL=

# ---------------------------------------------------------------------------
# [OPCIONAL] Nombre del remoto de rclone que apunta a tu Drive.
# El remoto se crea a mano con `rclone config` (eso es a proposito: es el paso
# donde autorizas la cuenta y decides si cifras). Aqui solo va el NOMBRE, para
# que los scripts de copia y offload sepan a donde van.
RCLONE_REMOTE=

# ---------------------------------------------------------------------------
# [OPCIONAL] Token del tunel de Cloudflare (si no usas un tunel con nombre).
# Cloudflare Zero Trust -> Networks -> Tunnels -> crear -> token. Con tunel con
# nombre no hace falta: basta con el nombre del tunel ya configurado.
EZARR_CF_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# [OPCIONAL] Clave de subtitulos para Bazarr (OpenSubtitles.com o SubDL).
# Sin ella Bazarr usa el limite gratis del proveedor, que son unas 20 descargas
# al dia. Con clave, el limite es el de tu cuenta.
EZARR_SUBS_API_KEY=

# ---------------------------------------------------------------------------
# [OPCIONAL] Auth key de Tailscale, para que el telefono se una solo al tailnet
# sin que tengas que teclear una URL de login. Tailscale -> Settings -> Keys ->
# Generate auth key. Caduca: para uso personal basta con una de 90 dias.
EZARR_TAILSCALE_AUTHKEY=
